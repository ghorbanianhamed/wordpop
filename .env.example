# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string (Neon: Dashboard -> Connect), e.g.
#   postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require
# Leave empty to use a local SQLite file.
DATABASE_URL=

# Long random string used to sign login sessions. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# Public address of the app (https in production - needed for secure cookies and push)
APP_URL=http://localhost:8000

# Web Push keys - generate with: python scripts/generate_vapid_keys.py
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Email for "Forgot password?" links. With Gmail: turn on 2-Step Verification, then create an
# App Password at https://myaccount.google.com/apppasswords and paste it below.
# Leave SMTP_HOST empty in local development: reset links are printed in the terminal instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
MAIL_FROM=you@gmail.com

# Secret for the reminder URL that UptimeRobot calls every 5 minutes:
#   https://YOUR-APP.onrender.com/api/tasks/send-notifications?key=CRON_SECRET
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(24))"
CRON_SECRET=

# Natural voices (optional): Azure AI Speech, free tier F0 = 500,000 characters/month.
# Azure portal -> Create a resource -> "Speech service" -> Pricing tier Free F0 -> Keys and Endpoint.
# Copy KEY 1 and the Location/Region (e.g. canadacentral). Leave empty to use the phone's own voices.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# WordPop Plus (paid natural voices) through Stripe - optional. Without these, the voices are free.
# Stripe Dashboard -> Developers -> API keys (Secret key); Product catalogue -> WordPop Plus -> price IDs;
# Developers -> Webhooks -> endpoint https://YOUR-APP/api/billing/webhook -> Signing secret.
STRIPE_SECRET_KEY=
# Publishable key (pk_...): opens the payment form in a box inside the app. Optional - without it,
# customers go to Stripe's own payment page. Developers -> API keys -> Publishable key.
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
# Shown in the app (must match the Stripe prices)
PLUS_PRICE_MONTHLY_LABEL=CA$0.99
PLUS_PRICE_YEARLY_LABEL=CA$9.99
PLUS_TRIAL_DAYS=7

# Google Play app (Trusted Web Activity) - optional. Served at /.well-known/assetlinks.json so the app
# opens without a browser bar. See docs/google-play/README.md.
ANDROID_PACKAGE_NAME=
# SHA-256 fingerprints, comma-separated: Play Console -> App integrity (app signing key) + upload key
ANDROID_SHA256_CERT_FINGERPRINTS=

# Comma-separated emails that can see the /admin statistics page
ADMIN_EMAILS=you@example.com
